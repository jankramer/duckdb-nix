Subject: [PATCH] Build against external duckdb

---
 CMakeLists.txt                             | 719 ++-------------------
 src/jni/duckdb_java.cpp                    |   2 -
 src/main/java/org/duckdb/DuckDBNative.java |  55 +-
 src/test/java/org/duckdb/TestNoLib.java    |  24 +-
 4 files changed, 71 insertions(+), 729 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 073294d7..aeb5b34f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,704 +1,95 @@
-# Java and JNI
+cmake_minimum_required(VERSION 3.16)
 
-find_package(Java 1.8)
+project(DuckDBJavaExternal C CXX Java)
 
-set(JAVA_AWT_LIBRARY NotNeeded)
-set(JAVA_JVM_LIBRARY NotNeeded)
-
-find_package(JNI)
-
-cmake_minimum_required(VERSION 3.5...3.29)
-set(CMAKE_CXX_STANDARD "11" CACHE STRING "C++ standard to enforce")
-set(CMAKE_VERBOSE_MAKEFILE OFF)
+set(CMAKE_CXX_STANDARD 11 CACHE STRING "C++ standard to enforce")
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
-set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
 
-option(ENABLE_ADDRESS_SANITIZER "Enable address sanitizer." FALSE)
+find_package(Java 1.8 REQUIRED)
+set(JAVA_AWT_LIBRARY NotNeeded)
+set(JAVA_JVM_LIBRARY NotNeeded)
+find_package(JNI REQUIRED)
+find_package(DuckDB CONFIG REQUIRED)
 
-if(NOT JNI_FOUND OR NOT Java_FOUND)
-  message(FATAL_ERROR "No compatible Java/JNI found")
+if(NOT TARGET duckdb)
+  message(FATAL_ERROR "DuckDBConfig.cmake did not define the duckdb target")
 endif()
-
-if(NOT(Java_VERSION_MAJOR STREQUAL "1" AND Java_VERSION_MINOR STREQUAL "8"))
-  message(WARNING "JDK ${Java_VERSION} is used to compile the Java part of the driver, resulting binaries will NOT be compatible with JDK 8.")
+if(NOT DuckDB_INCLUDE_DIRS)
+  message(FATAL_ERROR "DuckDBConfig.cmake did not define DuckDB_INCLUDE_DIRS")
 endif()
 
 include(UseJava)
 
-
-# project definition
-
-project(DuckDBJava C CXX Java)
-
-if (NOT CMAKE_BUILD_TYPE OR CMAKE_BUILD_TYPE STREQUAL "")
-    set(CMAKE_BUILD_TYPE "Release" CACHE STRING "" FORCE)
