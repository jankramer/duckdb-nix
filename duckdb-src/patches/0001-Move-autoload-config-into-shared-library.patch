+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/main/extension_entries_shared.hpp
+//
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb/main/extension_entries.hpp"
+
+#ifndef DUCKDB_EXTENSION_ENTRIES_API
+#if defined(_WIN32) && defined(DUCKDB_EXTENSION_ENTRIES_BUILD)
+#define DUCKDB_EXTENSION_ENTRIES_API __declspec(dllexport)
+#elif defined(_WIN32)
+#define DUCKDB_EXTENSION_ENTRIES_API __declspec(dllimport)
+#else
+#define DUCKDB_EXTENSION_ENTRIES_API
+#endif
+#endif
+
+namespace duckdb {
+
+struct DuckDBExtensionEntriesV1 {
+	uint32_t abi_version;
+
+	const ExtensionFunctionEntry *functions;
+	idx_t functions_count;
+
+	const ExtensionFunctionOverloadEntry *function_overloads;
+	idx_t function_overloads_count;
+
+	const ExtensionEntry *settings;
+	idx_t settings_count;
+
+	const ExtensionEntry *secret_types;
+	idx_t secret_types_count;
+
+	const ExtensionEntry *copy_functions;
+	idx_t copy_functions_count;
+
+	const ExtensionEntry *types;
+	idx_t types_count;
+
+	const ExtensionEntry *collations;
+	idx_t collations_count;
+
+	const ExtensionEntry *file_prefixes;
+	idx_t file_prefixes_count;
+
+	const ExtensionEntry *file_postfixes;
+	idx_t file_postfixes_count;
+
+	const ExtensionEntry *file_contains;
+	idx_t file_contains_count;
+
+	const ExtensionEntry *secret_providers;
+	idx_t secret_providers_count;
+
+	const char *const *autoloadable_extensions;
+	idx_t autoloadable_extensions_count;
+
+	const char *default_extension_directories;
+};
+
+extern "C" DUCKDB_EXTENSION_ENTRIES_API const DuckDBExtensionEntriesV1 *duckdb_extension_entries_v1();
+
+enum class ExtensionEntryKind : uint8_t {
+	SETTINGS,
+	SECRET_TYPES,
+	COPY_FUNCTIONS,
+	TYPES,
+	COLLATIONS,
+	FILE_PREFIXES,
+	FILE_POSTFIXES,
+	FILE_CONTAINS,
+	SECRET_PROVIDERS
+};
+
+class ExtensionEntryCollection {
+public:
+	typedef ExtensionEntry value_type;
+
+	constexpr explicit ExtensionEntryCollection(ExtensionEntryKind kind) : kind(kind) {
+	}
+
+	const ExtensionEntry *begin() const;
+	const ExtensionEntry *end() const;
+	idx_t size() const;
+	const ExtensionEntry &operator[](idx_t index) const;
+
+private:
+	const ExtensionEntry *data() const;
+
+private:
+	ExtensionEntryKind kind;
+};
+
+class ExtensionFunctionEntryCollection {
+public:
+	typedef ExtensionFunctionEntry value_type;
+
+	const ExtensionFunctionEntry *begin() const;
+	const ExtensionFunctionEntry *end() const;
+	idx_t size() const;
+	const ExtensionFunctionEntry &operator[](idx_t index) const;
+
+private:
+	const ExtensionFunctionEntry *data() const;
+};
+
+class ExtensionFunctionOverloadEntryCollection {
+public:
+	typedef ExtensionFunctionOverloadEntry value_type;
+
+	const ExtensionFunctionOverloadEntry *begin() const;
+	const ExtensionFunctionOverloadEntry *end() const;
+	idx_t size() const;
+	const ExtensionFunctionOverloadEntry &operator[](idx_t index) const;
+
+private:
+	const ExtensionFunctionOverloadEntry *data() const;
+};
+
+class AutoloadableExtensionCollection {
+public:
+	typedef const char *value_type;
+
+	const char *const *begin() const;
+	const char *const *end() const;
+	idx_t size() const;
+	const char *operator[](idx_t index) const;
+
+private:
+	const char *const *data() const;
+};
+
+class ExtensionEntries {
+public:
+	static const DuckDBExtensionEntriesV1 &Get();
+	static const char *DefaultExtensionDirectories();
+
+	static ExtensionFunctionEntryCollection Functions();
+	static ExtensionFunctionOverloadEntryCollection FunctionOverloads();
+	static ExtensionEntryCollection Settings();
+	static ExtensionEntryCollection SecretTypes();
+	static ExtensionEntryCollection CopyFunctions();
+	static ExtensionEntryCollection Types();
+	static ExtensionEntryCollection Collations();
+	static ExtensionEntryCollection FilePrefixes();
+	static ExtensionEntryCollection FilePostfixes();
+	static ExtensionEntryCollection FileContains();
+	static ExtensionEntryCollection SecretProviders();
+	static AutoloadableExtensionCollection AutoloadableExtensions();
+};
+
+} // namespace duckdb
