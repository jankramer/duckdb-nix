@@ -0,0 +1,190 @@
+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/main/extension_entries.cpp
+//
+//===----------------------------------------------------------------------===//
+
+#include "duckdb/main/extension_entries_shared.hpp"
+
+namespace duckdb {
+
+const DuckDBExtensionEntriesV1 &ExtensionEntries::Get() {
+	return *duckdb_extension_entries_v1();
+}
+
+const char *ExtensionEntries::DefaultExtensionDirectories() {
+	return Get().default_extension_directories;
+}
+
+ExtensionFunctionEntryCollection ExtensionEntries::Functions() {
+	return ExtensionFunctionEntryCollection();
+}
+
+ExtensionFunctionOverloadEntryCollection ExtensionEntries::FunctionOverloads() {
+	return ExtensionFunctionOverloadEntryCollection();
+}
+
+ExtensionEntryCollection ExtensionEntries::Settings() {
+	return ExtensionEntryCollection(ExtensionEntryKind::SETTINGS);
+}
+
+ExtensionEntryCollection ExtensionEntries::SecretTypes() {
+	return ExtensionEntryCollection(ExtensionEntryKind::SECRET_TYPES);
+}
+
+ExtensionEntryCollection ExtensionEntries::CopyFunctions() {
+	return ExtensionEntryCollection(ExtensionEntryKind::COPY_FUNCTIONS);
+}
+
+ExtensionEntryCollection ExtensionEntries::Types() {
+	return ExtensionEntryCollection(ExtensionEntryKind::TYPES);
+}
+
+ExtensionEntryCollection ExtensionEntries::Collations() {
+	return ExtensionEntryCollection(ExtensionEntryKind::COLLATIONS);
+}
+
+ExtensionEntryCollection ExtensionEntries::FilePrefixes() {
+	return ExtensionEntryCollection(ExtensionEntryKind::FILE_PREFIXES);
+}
+
+ExtensionEntryCollection ExtensionEntries::FilePostfixes() {
+	return ExtensionEntryCollection(ExtensionEntryKind::FILE_POSTFIXES);
+}
+
+ExtensionEntryCollection ExtensionEntries::FileContains() {
+	return ExtensionEntryCollection(ExtensionEntryKind::FILE_CONTAINS);
+}
+
+ExtensionEntryCollection ExtensionEntries::SecretProviders() {
+	return ExtensionEntryCollection(ExtensionEntryKind::SECRET_PROVIDERS);
+}
+
+AutoloadableExtensionCollection ExtensionEntries::AutoloadableExtensions() {
+	return AutoloadableExtensionCollection();
+}
+
+const ExtensionEntry *ExtensionEntryCollection::data() const {
+	auto &entries = ExtensionEntries::Get();
+	switch (kind) {
+	case ExtensionEntryKind::SETTINGS:
+		return entries.settings;
+	case ExtensionEntryKind::SECRET_TYPES:
+		return entries.secret_types;
+	case ExtensionEntryKind::COPY_FUNCTIONS:
+		return entries.copy_functions;
+	case ExtensionEntryKind::TYPES:
+		return entries.types;
+	case ExtensionEntryKind::COLLATIONS:
+		return entries.collations;
+	case ExtensionEntryKind::FILE_PREFIXES:
+		return entries.file_prefixes;
+	case ExtensionEntryKind::FILE_POSTFIXES:
+		return entries.file_postfixes;
+	case ExtensionEntryKind::FILE_CONTAINS:
+		return entries.file_contains;
+	case ExtensionEntryKind::SECRET_PROVIDERS:
+		return entries.secret_providers;
+	}
+	return nullptr;
+}
+
+idx_t ExtensionEntryCollection::size() const {
+	auto &entries = ExtensionEntries::Get();
+	switch (kind) {
+	case ExtensionEntryKind::SETTINGS:
+		return entries.settings_count;
+	case ExtensionEntryKind::SECRET_TYPES:
+		return entries.secret_types_count;
+	case ExtensionEntryKind::COPY_FUNCTIONS:
+		return entries.copy_functions_count;
+	case ExtensionEntryKind::TYPES:
+		return entries.types_count;
+	case ExtensionEntryKind::COLLATIONS:
+		return entries.collations_count;
+	case ExtensionEntryKind::FILE_PREFIXES:
+		return entries.file_prefixes_count;
+	case ExtensionEntryKind::FILE_POSTFIXES:
+		return entries.file_postfixes_count;
+	case ExtensionEntryKind::FILE_CONTAINS:
+		return entries.file_contains_count;
+	case ExtensionEntryKind::SECRET_PROVIDERS:
+		return entries.secret_providers_count;
+	}
+	return 0;
+}
+
+const ExtensionEntry *ExtensionEntryCollection::begin() const {
+	return data();
+}
+
+const ExtensionEntry *ExtensionEntryCollection::end() const {
+	return data() + size();
+}
